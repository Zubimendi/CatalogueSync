generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_WRITE")
}

model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  listings   ProductListing[]
  suborders  VendorSuborder[]

  @@map("vendors")
}

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  listings ProductListing[]

  @@map("categories")
}

model ProductListing {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  sku         String
  title       String
  description String   @default("")
  priceCents  BigInt   @map("price_cents")
  currency    String   @default("USD")
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  category  Category        @relation(fields: [categoryId], references: [id])
  inventory Inventory?
  lineItems OrderLineItem[]

  @@unique([vendorId, sku])
  @@index([vendorId], map: "idx_product_listings_vendor")
  @@index([categoryId], map: "idx_product_listings_category")
  @@map("product_listings")
}

model Inventory {
  listingId        String   @id @map("listing_id") @db.Uuid
  onHandQuantity   Int      @default(0) @map("on_hand_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  listing ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  vendorId    String?   @map("vendor_id") @db.Uuid
  operation   String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([id], map: "idx_outbox_unprocessed")
  @@map("outbox_events")
}

model CatalogListingsView {
  listingId          String   @id @map("listing_id") @db.Uuid
  vendorId           String   @map("vendor_id") @db.Uuid
  vendorName         String   @map("vendor_name")
  vendorStatus       String   @map("vendor_status")
  categoryId         String   @map("category_id") @db.Uuid
  categoryName       String   @map("category_name")
  title              String
  description        String
  priceCents         BigInt   @map("price_cents")
  currency           String
  status             String
  availableQuantity  Int      @map("available_quantity")
  lastSyncedOutboxId BigInt   @map("last_synced_outbox_id")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([categoryId], map: "idx_catalog_view_category")
  @@index([vendorId], map: "idx_catalog_view_vendor")
  @@index([priceCents], map: "idx_catalog_view_price")
  @@map("catalog_listings_view")
}

model CustomerOrder {
  id         String   @id @default(uuid()) @db.Uuid
  buyerRef   String   @map("buyer_ref")
  status     String   @default("PENDING")
  totalCents BigInt   @default(0) @map("total_cents")
  currency   String   @default("USD")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  vendorSuborders VendorSuborder[]
  sagaSteps       SagaStep[]

  @@map("customer_orders")
}

model VendorSuborder {
  id              String   @id @default(uuid()) @db.Uuid
  customerOrderId String   @map("customer_order_id") @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  status          String   @default("PENDING_RESERVATION")
  subtotalCents   BigInt   @default(0) @map("subtotal_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customerOrder CustomerOrder   @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  lineItems     OrderLineItem[]
  sagaSteps     SagaStep[]

  @@unique([customerOrderId, vendorId])
  @@index([customerOrderId], map: "idx_vendor_suborders_order")
  @@map("vendor_suborders")
}

model OrderLineItem {
  id               String   @id @default(uuid()) @db.Uuid
  vendorSuborderId String   @map("vendor_suborder_id") @db.Uuid
  listingId        String   @map("listing_id") @db.Uuid
  quantity         Int
  unitPriceCents   BigInt   @map("unit_price_cents")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendorSuborder VendorSuborder @relation(fields: [vendorSuborderId], references: [id], onDelete: Cascade)
  listing        ProductListing @relation(fields: [listingId], references: [id])

  @@index([vendorSuborderId], map: "idx_order_line_items_suborder")
  @@map("order_line_items")
}

model SagaStep {
  id                 BigInt   @id @default(autoincrement())
  customerOrderId    String   @map("customer_order_id") @db.Uuid
  vendorSuborderId   String?  @map("vendor_suborder_id") @db.Uuid
  stepType           String   @map("step_type")
  detail             Json     @default("{}")
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  customerOrder  CustomerOrder   @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  vendorSuborder VendorSuborder? @relation(fields: [vendorSuborderId], references: [id])

  @@index([customerOrderId, occurredAt], map: "idx_saga_steps_order")
  @@map("saga_steps")
}
