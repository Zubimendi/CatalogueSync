# Three separate connection strings, one per Postgres role — see
# docs/ARCHITECTURE.md §4. This is not redundancy; each one is deliberately
# scoped to a different set of grants.
DATABASE_URL_WRITE=postgres://catalogsync_write:catalogsync_write_dev_password@localhost:5432/catalogsync
DATABASE_URL_READ=postgres://catalogsync_read:catalogsync_read_dev_password@localhost:5432/catalogsync
DATABASE_URL_PROJECTOR=postgres://catalogsync_projector:catalogsync_projector_dev_password@localhost:5432/catalogsync

REDIS_URL=redis://localhost:6379/0

HTTP_PORT=3000

# HMAC signing secret for actor/vendor tokens — deliberately minimal,
# see docs/ARCHITECTURE.md §6/§11 and docs/CURSOR_CONTEXT.md §7.
ACTOR_TOKEN_SECRET=dev-secret-change-me

# Outbox projector
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=200
OUTBOX_MAX_ATTEMPTS=5

# Read-model cache
CATALOG_CACHE_TTL_SECONDS=60

# The saga's correctness backstop — see docs/ARCHITECTURE.md §8.
SAGA_TIMEOUT_SECONDS=120
SAGA_SWEEP_INTERVAL_MS=15000
